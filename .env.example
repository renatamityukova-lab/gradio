# Шаблон переменных окружения проекта gradio.
# Скопируйте в .env и заполните значения. Файл .env в git не попадает.
#   copy gradio\.env.example gradio\.env    (Windows cmd)
#   cp gradio/.env.example gradio/.env      (bash)
#
# ВАЖНО: реальный ключ хранится только в .env. Не коммитить, не выводить в логи,
# не печатать в консоль и не передавать в сообщения об ошибках.

# API-ключ LLM (обязательно)
OPENAI_API_KEY=your_api_key_here

# Параметры LLM — те же, что в проекте translation
LLM_PROVIDER=openai
LLM_MODEL=gpt-oss-120b
LLM_FALLBACK_MODEL=MiniMax-M2.7
LLM_BASE_URL=https://llm.enplus.group/v1
LLM_FALLBACK_BASE_URL=
LLM_TRUST_ENV=true

# Необязательные параметры клиента
# Повторы только для временных ошибок (5xx/429, таймаут/сеть): 1 — один повтор.
LLM_MAX_RETRIES=1
LLM_TIMEOUT_SECONDS=60
